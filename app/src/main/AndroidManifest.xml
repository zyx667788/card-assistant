<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Shizuku 包可见性 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="moe.shizuku.api" />
        <package android:name="kerneldroid.nightzuku" />
        <package android:name="af.shizuku.plus.api" />
    </queries>

    <application
        android:name=".GameOcrApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GameOcr"
        tools:targetApi="35">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <!-- 主界面 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GameOcr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Unified user-initiated capture startup and optional system consent. -->
        <activity
            android:name=".capture.CaptureStartRequestActivity"
            android:exported="false"
            android:theme="@style/Theme.GameOcr.Transparent"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <service
            android:name=".service.CaptureQuickSettingsTileService"
            android:exported="true"
            android:icon="@drawable/ic_quick_settings_tile"
            android:label="@string/quick_settings_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- 截屏前台服务：mediaProjection 用于投屏授权；specialUse 用于 Shizuku / 无障碍路径 -->
        <!-- configChanges 必须包含 orientation+screenSize+screenLayout+smallestScreenSize：
             旋转屏幕时由 Service 自己接 onConfigurationChanged，按比例重算悬浮窗位置 +
             updateViewLayout。否则旋转后悬浮窗位置会废（竖屏 y=200 横屏可能落到状态栏后）。 -->
        <service
            android:name=".service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-demand screen capture via Shizuku or an enabled accessibility service for card game assistance" />
        </service>

        <!-- Shizuku provider：用于让 Shizuku 服务把 IBinder 绑过来 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ExportedContentProvider" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logfileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_file_paths" />
        </provider>

        <!-- 可选无障碍服务：截屏后端之一 + 音量键触发分析。 -->
        <service
            android:name=".trigger.GameOcrAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_summary"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_config" />
        </service>

        <!-- MIUI / HyperOS 特殊配置：允许 overlay window 在横屏延伸到 long-edge cutout
             区域，否则系统默认 letterbox 让 window 不能覆盖 cutout，左边露物理屏黑条。
             不是 Google 标准 API（PhoneWindowManager 硬限制），仅小米 OEM 提供放开通道。 -->
        <meta-data
            android:name="notch.config"
            android:value="portrait|landscape" />

    </application>

</manifest>
