<?xml version="1.0" encoding="utf-8"?>
<!--
  允许明文（http://）流量整体放开，是为了支持用户自架的局域网 / localhost 推理服务
  （如 http://192.168.x.x:8000/v1）。真正执行「非 HTTPS 仅允许私有网段 + 用户白名单」
  的安全边界在 OkHttp 拦截器 PrivateCleartextInterceptor 里：对公网 hostname 的 http
  请求会被直接拒绝。应用只有一个共享 OkHttpClient，全部请求都过这个拦截器。
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
